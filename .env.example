# The AI brain, for "Talk to me" and the "Describe it" drafts. Claude is used when set; otherwise OpenAI.
ANTHROPIC_API_KEY=
# Optional: claude-haiku-5-5 is faster, claude-opus-5-5 is smarter.
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI: fallback model, and embeddings for the Pinecone CV index.
OPENAI_API_KEY=
# Optional: only used when ANTHROPIC_API_KEY is not set.
OPENAI_MODEL=gpt-5.4-mini
PINECONE_API_KEY=
PINECONE_INDEX=

# Zuhayr's cloned voice (ElevenLabs) for speech and voice input.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: eleven_v4 sounds closest to a cloned voice; eleven_flash_v2_5 is fastest.
ELEVENLABS_MODEL=eleven_flash_v2_5

# Contact form email.
RESEND_API_KEY=
